{
  "family": "iscoolgpt-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "iscoolgpt",
      "image": "186639342634.dkr.ecr.us-east-1.amazonaws.com/iscoolgpt:production-latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "LLM_PROVIDER",
          "value": "mock"
        },
        {
          "name": "OPENAI_MODEL",
          "value": "gpt-3.5-turbo"
        },
        {
          "name": "MAX_TOKENS",
          "value": "500"
        },
        {
          "name": "TEMPERATURE",
          "value": "0.7"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import httpx; httpx.get('http://localhost:8000/health')\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}


# LLM Provider Configuration
LLM_PROVIDER=mock
# Options: openai, gemini, huggingface, mock (mock não requer API key - ideal para testes)

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Google Gemini Configuration (se usar gemini)
GEMINI_API_KEY=AIzaSyA95NjsjUNavEhpwnfWXDh4H0M1jzHmcGw
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face Configuration (se usar huggingface)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=microsoft/DialoGPT-medium
HUGGINGFACE_API_URL=https://api-inference.huggingface.co/models

# Application Settings
MAX_TOKENS=500
TEMPERATURE=0.7

# AWS Configuration (para deploy)
AWS_REGION=us-east-1
ECR_REPOSITORY=iscoolgpt
ECS_CLUSTER=iscoolgpt-cluster
ECS_SERVICE=iscoolgpt-service

